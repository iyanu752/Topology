@TopologyServer_HostAddress = http://localhost:5023
@AccessToken = auth0-access-token-here
@RoomId = paste-room-id-here
@RoomKey = 123456

### Public auth check
GET {{TopologyServer_HostAddress}}/api/auth/public
Accept: application/json

###

### Get or create current user's database profile
GET {{TopologyServer_HostAddress}}/api/auth/profile
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

### Delete current user's database profile
DELETE {{TopologyServer_HostAddress}}/api/auth/profile
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

### Create public room
POST {{TopologyServer_HostAddress}}/api/room/create
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "type": "Public",
  "roomKey": null
}

###

### Create private room
POST {{TopologyServer_HostAddress}}/api/room/create
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "type": "Private",
  "roomKey": {{RoomKey}}
}

###

### Join public room
POST {{TopologyServer_HostAddress}}/api/room/join
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "id": "{{RoomId}}",
  "roomKey": null
}

###

### Join private room
POST {{TopologyServer_HostAddress}}/api/room/join
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "id": "{{RoomId}}",
  "roomKey": {{RoomKey}}
}

###

### Delete room
DELETE {{TopologyServer_HostAddress}}/api/room
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "id": "{{RoomId}}",
  "roomKey": {{RoomKey}}
}

###

### Get room design
GET {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/design
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

### Save room design
PUT {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/design
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "nodes": [
    {
      "id": "gateway-1",
      "type": "ApiGateway",
      "label": "API Gateway",
      "x": 80,
      "y": 80,
      "properties": {
        "replicas": 2,
        "rateLimitPerMinute": 6000,
        "authEnabled": true,
        "requestTimeoutMs": 3000,
        "retriesEnabled": true
      }
    },
    {
      "id": "node-1",
      "type": "Service",
      "label": "API Server",
      "x": 120,
      "y": 80,
      "properties": {
        "replicas": 2
      }
    },
    {
      "id": "node-2",
      "type": "Database",
      "label": "MongoDB",
      "x": 420,
      "y": 80,
      "properties": {
        "engine": "MongoDB",
        "replicas": 1,
        "backupEnabled": false,
        "failoverEnabled": false
      }
    }
  ],
  "edges": [
    {
      "id": "edge-gateway-service",
      "sourceNodeId": "gateway-1",
      "targetNodeId": "node-1",
      "label": "routes"
    },
    {
      "id": "edge-1",
      "sourceNodeId": "node-1",
      "targetNodeId": "node-2",
      "label": "reads/writes"
    }
  ]
}

###

### Delete room design
DELETE {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/design
Accept: application/json
Authorization: Bearer {{AccessToken}}

###
###

### Get component library
GET {{TopologyServer_HostAddress}}/api/components
Accept: application/json

###

### Get database component definition
GET {{TopologyServer_HostAddress}}/api/components/Database
Accept: application/json

###

### Get API gateway component definition
GET {{TopologyServer_HostAddress}}/api/components/ApiGateway
Accept: application/json

###

### Seed default component library
POST {{TopologyServer_HostAddress}}/api/components/seed
Accept: application/json

###
###

### Get connection rules
GET {{TopologyServer_HostAddress}}/api/connection-rules
Accept: application/json

###

### Get one connection rule
GET {{TopologyServer_HostAddress}}/api/connection-rules/Client/Database
Accept: application/json

###

### Get API gateway connection rule
GET {{TopologyServer_HostAddress}}/api/connection-rules/Client/ApiGateway
Accept: application/json

###

### Seed default connection rules
POST {{TopologyServer_HostAddress}}/api/connection-rules/seed
Accept: application/json

###

### Validate room design
POST {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/design/validate
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "nodes": [
    {
      "id": "client-1",
      "type": "Client",
      "label": "Client",
      "x": 80,
      "y": 80,
      "properties": {}
    },
    {
      "id": "db-1",
      "type": "Database",
      "label": "Database",
      "x": 360,
      "y": 80,
      "properties": {
        "engine": "Postgres",
        "replicas": 1,
        "storageGb": 20
      }
    }
  ],
  "edges": [
    {
      "id": "edge-gateway-service",
      "sourceNodeId": "gateway-1",
      "targetNodeId": "node-1",
      "label": "routes"
    },
    {
      "id": "edge-1",
      "sourceNodeId": "client-1",
      "targetNodeId": "db-1",
      "label": "direct connection"
    }
  ]
}

###
###

### Run database failure simulation
POST {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/simulations/run
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "scenario": "DatabaseFailure",
  "trafficPerSecond": 2500,
  "hasCriticalWrites": true,
  "failedNodeIds": ["node-2"]
}

###


###

### Run normal traffic simulation
POST {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/simulations/run
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "scenario": "NormalTraffic",
  "trafficPerSecond": 300,
  "readPercentage": 70,
  "writePercentage": 30,
  "hasCriticalWrites": false,
  "failedNodeIds": []
}

###

### Run high traffic simulation
POST {{TopologyServer_HostAddress}}/api/rooms/{{RoomId}}/simulations/run
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "scenario": "HighTraffic",
  "trafficPerSecond": 2500,
  "readPercentage": 85,
  "writePercentage": 15,
  "hasCriticalWrites": false,
  "failedNodeIds": []
}

###
